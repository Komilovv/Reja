<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>REJA</title>
    <link 
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
        integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z"
        crossorigin="anonymous"
        />
</head>
<body style="background-color: #b8bbd1">
    <div class="container">
        <h1>REJA VA MAQSADLAR</h1>

        <div class="jumbotron p-3 shadow-sm">
            <form id="create-form" action="/create-item" method="POST">
                <div class="d-flex align-items-center">
                    <input 
                    type="text" 
                    name="reja" 
                    id="create-field" 
                    class="form-control mr-3" 
                    style="flex: 1"
                    autofocus
                    autocomplete="off"
                    placeholder="Maqsadni kiriting" required
                    />
                    <button class="btn btn-primary" style="border-radius: 20px;">
                       Yangi Reja Qo'shish
                    </button>
                </div>
            </form>
        </div>

        <ul id="item-list" class="list-group pb-5">
            <% plans.map(function(item) { %>
                <li
                    class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
                >
                    <span class="item-text"><%= item.plan %></span>
                    <div>
                        <button
                            data-id="<%= item._id %>"
                            class="edit-me btn btn-secondary btn-sm mr-1"
                        >
                            O'zgartirish
                        </button>
                        <button data-id="<%= item._id %>" class="delete-me btn btn-danger btn-sm">O'chirish</button>
                    </div>  
                </li>
            <% }) %>
        </ul>

        <div>
            <button class="btn btn-danger" id="clean-all" style="border-radius: 20px;">
                Hamma Rejalarni O'chirish
            </button>
        </div>
    </div>
    <script src="https://unpkg.com/axios@1.13.2/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
</body>
</html>